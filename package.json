{
  "name": "mr-little-coffee",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "dev:api": "pnpm --dir backend dev",
    "build": "pnpm --dir erp build && pnpm --dir frontend build && pnpm --dir backend build",
    "build:api": "pnpm --dir backend build",
    "start": "pnpm --dir frontend start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --dir frontend test && pnpm --dir backend test",
    "test:api": "pnpm --dir backend test",
    "test:integration": "pnpm --dir backend test:integration",
    "db:migrate": "pnpm --dir backend migration:run",
    "db:seed": "pnpm --dir backend seed",
    "verify:home": "node scripts/verify-home.cjs",
    "demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-demo.ps1",
    "demo:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-demo.ps1"
  }
}
