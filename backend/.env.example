NODE_ENV=development
PORT=4000
# Classroom-only accounts: admin / 1234 and cliente / 1234. Rejects true in production.
# Enable, run migrations and seed, then restart the API. Disabled by default.
DEMO_ACCOUNTS_ENABLED=false
# Create a local PostgreSQL database and replace these placeholders; never commit .env.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/mr_little_coffee
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CSRF_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_MINUTES=120
COOKIE_SAME_SITE=lax
# Provisional business rules; business confirmation required.
BUSINESS_TIMEZONE=America/El_Salvador
OPENING_HOUR=7
CLOSING_HOUR=21
SLOT_MINUTES=60
SLOT_CAPACITY=20
MIN_PEOPLE=1
MAX_PEOPLE=6
MIN_NOTICE_MINUTES=30
MAX_ADVANCE_DAYS=30
# Integration tests require a DIFFERENT disposable database with test in its name.
# TEST_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/mr_little_coffee_test
